    "AI study isn’t available on this device. Reading and search still work." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estudio con IA no está disponible en este dispositivo. La lectura y la búsqueda siguen funcionando."
          }
