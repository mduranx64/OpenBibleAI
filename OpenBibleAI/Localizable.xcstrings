      }
    },
    "All words, any order. Use quotes for a phrase." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las palabras, en cualquier orden. Usa comillas para una frase."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as palavras, em qualquer ordem. Use aspas para uma frase."
          }
        }
      }
    },
    "Answers are generated on this device and may be wrong. Check important points against the text." : {
      "localizations" : {
